<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <customErrors mode="Off" />
    <compilation debug="true" />
  </system.web>

  <system.webServer>
    <!-- WebSockets desteği -->
    <webSocket enabled="false" />

    <!-- iisnode işleyicisi: server.js dosyası ile Next.js başlatılır -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Yeniden Yazma Kuralları (Rewrite Rules) -->
    <rewrite>
      <rules>
        <!-- Statik dosyalara ve public klasörüne doğrudan erişim ver -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](html|htm|svg|js|css|png|gif|jpg|jpeg|ico|json|woff|woff2|ttf|eot))" />
          <action type="None" />
        </rule>

        <!-- Node.js debug log dizinini dışarıya kapat -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Diğer tüm dinamik istekleri server.js'e yönlendir -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Hataların tarayıcıda detaylı (stack trace ile) gösterilmesi için -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <!-- iisnode Hata ve Log Ayarları -->
    <iisnode
      node_env="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="true"
      devErrorsEnabled="true"
      flushResponse="true"
      watchedFiles="web.config;*.js"
    />
  </system.webServer>
</configuration>
