<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <remove name="iisnode" />
      <add name="iisnode" path="server.iis.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Statik dosyalara ve public klasörüne doğrudan erişim ver -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](html|htm|svg|js|css|png|gif|jpg|jpeg|ico|json|woff|woff2|ttf|eot))" />
          <action type="None" />
        </rule>

        <!-- Node.js debug log dizinini dışarıya kapat -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server\.iis\.js\/debug[\/]?" />
        </rule>

        <!-- Diğer tüm dinamik istekleri server.iis.js üzerine yönlendir -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.iis.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Detaylı Hata Raporlama -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <!-- iisnode Hata ve Log Ayarları -->
    <iisnode
      node_env="production"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="true"
      devErrorsEnabled="true"
      watchedFiles="web.config;*.js"
    />
  </system.webServer>
</configuration>
