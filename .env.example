# ==========================================
# 🗄️ Database (Microsoft SQL Server)
# ==========================================
DATABASE_URL="sqlserver://localhost:1433;database=MyBlog;user=sa;password=your_password;encrypt=true;trustServerCertificate=true"

# Uygulama açılırken şemayı otomatik güncelle (true/false)
AUTO_MIGRATE=true

# ==========================================
# 🔐 Auth.js (NextAuth v5) & Admin Credentials
# ==========================================
AUTH_SECRET=change-me-generate-a-real-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password-123

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ==========================================
# 🌐 Application
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 🪣 MinIO (S3 Object Storage for Images)
# ==========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=my-blog-images
MINIO_REGION=us-east-1
